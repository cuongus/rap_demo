managed implementation in class zbp_i_rap_einv_paym_2 unique;
strict ( 2 );

with draft;
define behavior for ZI_RAP_EINV_PAYM_2 alias EInvoicePayment
persistent table zrap_einv_paym_2
draft table zrap_inv_paym_2d
lock master total etag Lastchangedat
authorization master ( instance )
etag master Lastchangedat
{
  create;
  update;
  delete;

  field ( readonly : update ) Zlsch, Paymtext;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare;

  mapping for zrap_einv_paym_2
    {
      Zlsch              = zlsch;
      Paymtext           = paymtext;
      Locallastchangedat = locallastchangedat;
      Locallastchangedby = locallastchangedby;
      Lastchangedat      = lastchangedat;
    }
}