projection;
strict ( 2 );
use draft;

define behavior for ZC_RAP_INV_USER alias EInvoiceUser
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _EInvoiceSerial { create; with draft; }
}

define behavior for ZC_RAP_INV_SERIAL alias EInvoiceSerial
{
  use update;
  use delete;

  use association _EInvoiceUser { with draft; }
}