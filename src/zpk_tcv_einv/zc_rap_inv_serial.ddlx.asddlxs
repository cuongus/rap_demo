@Metadata.layer: #CORE
@UI: {
      headerInfo:{ typeName: 'FormSerial',
                   typeNamePlural: 'FormSerial',
                   title: { type: #STANDARD, label: 'EInvoice type', value: 'Etype' }
                  },
      presentationVariant: [{ sortOrder: [{ by: 'Fiscalyear', direction: #ASC }, 
                                          { by: 'Etype', direction: #ASC }] }]
}
annotate view ZC_RAP_INV_SERIAL with
{
  @UI.facet: [
  {
  id: 'FormSerial',
  purpose: #STANDARD,
  type: #IDENTIFICATION_REFERENCE,
  label: 'Form Serial',
  position: 10
  }
  ]

  @UI.hidden: true
  Companycode;
  @UI.hidden: true
  Usertype;
  @UI.identification: [{ position: 10 }]
  @UI.lineItem: [{ position: 10 }]
  Fiscalyear;
  @UI.identification: [{ position: 20 }]
  @UI.lineItem: [{ position: 20 }]
  Etype;
  @UI.identification: [{ position: 30 }]
  @UI.lineItem: [{ position: 30 }]
  @UI.selectionField: [{ position: 30 }]
  Datetype;
  @UI.identification: [{ position: 40 }]
  @UI.lineItem: [{ position: 40 }]
  Form;
  @UI.identification: [{ position: 50 }]
  @UI.lineItem: [{ position: 50 }]
  Serial;

}