@Metadata.layer: #CORE
@UI:{
    headerInfo: { typeName: 'One-Time Account Data for Customer Items',
                  typeNamePlural: 'One-Time Account Data for Customer Items',
                  title: { value: 'AccountingDocument' }
    },
    presentationVariant: [{ sortOrder: [{ by: 'AccountingDocument', direction: #DESC },
    { by: 'AccountingDocumentItem', direction: #ASC },
    { by: 'FiscalYear', direction: #DESC }] }]
}
annotate entity ZC_ONETIME_CUS with
{
  @UI.facet          : [
   {
   id                 : 'General',
   purpose            : #STANDARD,
   position           : 10,
   isPartOfPreview    : true,
